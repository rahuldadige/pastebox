{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/index.js"
    },
    {
      "src": "/f/(.*)",
      "dest": "src/index.js"
    },
    {
      "src": "/g/(.*)",
      "dest": "src/index.js"
    },
    {
      "src": "/s/(.*)",
      "dest": "src/index.js"
    }
  ]
}
